diff --git a/src/clock/clock.c b/src/clock/clock.c
--- a/src/clock/clock.c
+++ b/src/clock/clock.c
@@ -1218,6 +1218,25 @@
     return clock->last_conversion;
 }
 
+/* Borrowed under the main clock lock. Unlike scalar conversion, consulting
+ * upcoming subtitle dates must not change the playback conversion reference. */
+struct vlc_clock_context *
+vlc_clock_GetConversionContext(vlc_clock_t *clock, vlc_tick_t system_now,
+                               vlc_tick_t reference_ts)
+{
+    AssertLocked(clock);
+    return vlc_clock_get_context(clock, system_now, reference_ts, false);
+}
+
+vlc_tick_t vlc_clock_ConvertToSystemWithContext(
+    vlc_clock_t *clock, struct vlc_clock_context *context,
+    vlc_tick_t system_now, vlc_tick_t ts, double rate)
+{
+    AssertLocked(clock);
+    assert(context != NULL);
+    return clock->ops->to_system(clock, context, system_now, ts, rate);
+}
+
 static const struct vlc_clock_ops master_ops = {
     .update = vlc_clock_master_update,
     .reset = vlc_clock_master_reset,
diff --git a/src/clock/clock.h b/src/clock/clock.h
--- a/src/clock/clock.h
+++ b/src/clock/clock.h
@@ -357,6 +357,23 @@
                                      double rate, uint32_t *clock_id);
 
 /**
+ * Borrow the timeline used to convert related subtitle timestamps.
+ *
+ * The main clock lock must remain held until the last conversion. The context
+ * cannot outlive that lock or a clock update/reset. This does not advance the
+ * clock's last-conversion reference; queued future cues are not playback.
+ */
+struct vlc_clock_context;
+struct vlc_clock_context *
+vlc_clock_GetConversionContext(vlc_clock_t *clock, vlc_tick_t system_now,
+                               vlc_tick_t reference_ts);
+
+/** Convert on the borrowed timeline without advancing the clock reference. */
+vlc_tick_t vlc_clock_ConvertToSystemWithContext(
+    vlc_clock_t *clock, struct vlc_clock_context *context,
+    vlc_tick_t system_now, vlc_tick_t ts, double rate);
+
+/**
  * Starts a new clock based on the given clock point, accounting for
  * previous updates.
  *
