+/** Mark an independent subtitle source whose PTS were aligned to the media.
+ * The main clock lock must be held. Cloned rendering clocks inherit this mode.
+ * Conversion follows changes of the live output context, including seeks.
+ * Embedded subtitle clocks retain their normal per-timestamp selection.
+ */
+void vlc_clock_SetFollowOutputTimeline(vlc_clock_t *clock);
+
+/**
+ * Borrow the timeline used to convert related subtitle timestamps.
+ *
+ * The main clock lock must remain held until the last conversion. The context
+ * cannot outlive that lock or a clock update/reset. This does not advance the
+ * clock's last-conversion reference; queued future cues are not playback.
+ */
+struct vlc_clock_context;
+struct vlc_clock_context *
+vlc_clock_GetConversionContext(vlc_clock_t *clock, vlc_tick_t system_now,
+                               vlc_tick_t reference_ts);
+
+/** Convert on the borrowed timeline without advancing the clock reference. */
+vlc_tick_t vlc_clock_ConvertToSystemWithContext(
+    vlc_clock_t *clock, struct vlc_clock_context *context,
+    vlc_tick_t system_now, vlc_tick_t ts, double rate);
+
 /**
