+        kind, clock->timing_diagnostic_id,
+        main_clock->master ? main_clock->master->timing_diagnostic_id : 0,
+        clock->track_str_id != NULL && !strcmp(clock->track_str_id, "input"),
+        now, pts, value, ctx->clock_id,
