+/* Opt-in numeric timing probe. No region text, paths, or addresses are read.
+ * Caller holds sys->lock. Event 0=queued, 1=waiting, 2=selected,
+ * 3=rejected, 4=removed, 5=expired-on-arrival. All ticks are microseconds.
+ * Per-entry state transitions are immediate; steady states are sampled at 1Hz.
+ * This does not intercept rendering or modify any playback/clock value. */
+static void
+spu_TraceSubtitleTiming(spu_private_t *sys, struct spu_channel *channel,
+                        spu_render_entry_t *entry, int event,
+                        vlc_tick_t now, vlc_tick_t render, vlc_tick_t boundary)
+{
+    if (!sys->subtitle_timing_enabled || !entry->subpic->b_subtitle)
+        return;
+    if (entry->timing_state == event && now >= entry->timing_last_log &&
+        now - entry->timing_last_log < VLC_TICK_FROM_SEC(1))
+        return;
+    entry->timing_state = event;
+    entry->timing_last_log = now;
+    const subpicture_t *pic = entry->subpic;
+    unsigned flags = (pic->b_ephemer ? 1u : 0u) |
+                     (entry->is_late ? 2u : 0u) |
+                     (channel && channel->clock ? 4u : 0u);
+    msg_Info(&sys->spu, "SWIFTVLC_SPU_V1 event=%d channel=%" PRId64
+             " order=%" PRId64 " now=%" PRId64 " render=%" PRId64
+             " org_start=%" PRId64 " org_stop=%" PRId64
+             " start=%" PRId64 " stop=%" PRId64
+             " pic_start=%" PRId64 " pic_stop=%" PRId64
+             " boundary=%" PRId64 " rate_ppm=%" PRId64
+             " delay=%" PRId64 " flags=%u",
+             event, (int64_t) pic->i_channel, pic->i_order, now, render,
+             entry->orgstart, entry->orgstop, entry->start, entry->stop,
+             pic->i_start, pic->i_stop, boundary,
+             channel ? (int64_t) (channel->rate * 1000000.) : 0,
+             channel ? channel->delay : 0, flags);
+}
+
 static void spu_Channel_CleanEntry(spu_private_t *sys, spu_render_entry_t *entry)
 {
     assert(entry->subpic);
 
+    spu_TraceSubtitleTiming(sys, NULL, entry, 4, vlc_tick_now(),
+                             VLC_TICK_INVALID, VLC_TICK_INVALID);
     spu_PrerenderCancel(sys, entry->subpic);
     subpicture_Delete(entry->subpic);
 }
